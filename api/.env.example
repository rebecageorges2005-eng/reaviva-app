# --- server ---
PORT=3000
JWT_SECRET=change-me-to-a-long-random-string
FRONTEND_DIR=../web
# Set to "true" when behind a proxy (Render/Railway/Heroku)
TRUST_PROXY=false

# --- PayPal Subscriptions (https://developer.paypal.com) ---
# Georges must provide these before launch (see README "Pagos con PayPal"):
PAYPAL_MODE=sandbox                  # sandbox | live
PAYPAL_CLIENT_ID=REPLACE_ME
PAYPAL_CLIENT_SECRET=REPLACE_ME
PAYPAL_PLAN_MONTHLY=REPLACE_ME       # plan ID (P-...) para $4.99 USD / mes
PAYPAL_PLAN_YEARLY=REPLACE_ME        # plan ID (P-...) para $39.99 USD / año
PAYPAL_WEBHOOK_ID=REPLACE_ME         # ID del webhook (verifica las firmas)
# Public base URL of this server (PayPal return/cancel redirects + webhook)
APP_URL=http://localhost:3000
